# =============================================================================
# X30 Live View — copy to .env (docker compose and `pnpm dev` read it)
# =============================================================================

# -----------------------------------------------------------------------------
# Cameras: RTSP addresses, read by go2rtc (docker/go2rtc.yaml)
# Replace the examples with the robot's own addresses and credentials, or set
# them in the app instead (Settings → Cameras), which hands them to go2rtc.
# -----------------------------------------------------------------------------

# Jueying X30 front camera
FRONT_RTSP=rtsp://192.168.1.120:554/front

# HIKMICRO HM-TD5567T-15/W (bi-spectrum PTZ). Hikvision-style paths:
# /Streaming/Channels/101 = channel 1 main stream, /201 = channel 2. Which
# channel is optical and which thermal: see the camera's web page.
PTZ_RTSP=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/101
THERMAL_RTSP=rtsp://admin:password@192.168.1.64:554/Streaming/Channels/201

# Hertzinno HZ-FA-371 acoustic imaging camera (path: see its manual)
ACOUSTIC_RTSP=rtsp://192.168.1.65:554/live

# -----------------------------------------------------------------------------
# Dashboard
# -----------------------------------------------------------------------------

# go2rtc as the browser reaches it, baked in at build time. Empty: the host
# that serves the dashboard, port 1984. Also changeable in the app's settings.
NEXT_PUBLIC_GO2RTC_URL=

# docker compose: where the dashboard listens
DASHBOARD_PORT=3000
DASHBOARD_BIND=0.0.0.0

# `pnpm dev` opened from a host other than localhost / LAN IPs / *.local
# (comma separated), e.g. a tunnel's hostname
# DEV_ORIGINS=
